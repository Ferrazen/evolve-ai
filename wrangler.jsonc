{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "evolve-ai",
  "main": "src/index.js",
  "compatibility_date": "2026-10-02",
  "ai": {
    "binding": "AI"
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "single-page-application"
  }
}
